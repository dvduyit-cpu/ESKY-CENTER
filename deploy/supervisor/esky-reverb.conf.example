[program:esky-reverb]
process_name=%(program_name)s
command=/usr/bin/php /var/www/esky/artisan reverb:start --host=127.0.0.1 --port=8080
directory=/var/www/esky
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
user=www-data
redirect_stderr=true
stdout_logfile=/var/www/esky/storage/logs/reverb.log
stopwaitsecs=10
