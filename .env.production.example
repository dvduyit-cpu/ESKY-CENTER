APP_NAME="E-SKY CENTER"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_database_user
DB_PASSWORD=CHANGE_ME

# Chỉ dùng một lần với ProductionBootstrapSeeder trên database mới hoàn toàn.
INITIAL_ADMIN_NAME="Quản trị viên"
INITIAL_ADMIN_EMAIL=admin@your-domain.example
INITIAL_ADMIN_PASSWORD=CHANGE_TO_A_STRONG_PASSWORD

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=notification@your-domain.example
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS=notification@your-domain.example
MAIL_FROM_NAME="${APP_NAME}"

# Use null when the host cannot run a persistent Reverb process.
BROADCAST_CONNECTION=null
